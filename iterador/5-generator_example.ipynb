    "def lines_with_number_of_words(arqchive, number):\n",
    "    with open(arqchive, 'r', enconding='utf-8') as file:\n",
    "        for line in file:\n",
    "            if len(line.split()) == number:\n",
    "                yield line.strip()"
   ]
